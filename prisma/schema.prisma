generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("account_manager") // super_admin | account_manager
  active       Boolean  @default(true)
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]

  @@index([email])
  @@index([role])
}

model Event {
  id                 String     @id @default(uuid())
  name               String
  date               String
  maxPrintsPerDevice Int        @default(5)
  active             Boolean    @default(true)
  ownerId            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  photos             Photo[]
  overlays           Overlay[]
  owner              User?      @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Overlay {
  id         String   @id @default(uuid())
  name       String
  url        String
  eventId    String?
  photoScale Int      @default(90)  // 50-100: how much photo fills the frame (100=full cover, lower=more padding)
  createdAt  DateTime @default(now())
  photos     Photo[]
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Photo {
  id               String   @id @default(uuid())
  eventId          String
  overlayId        String?
  photoUrl         String   @db.Text
  deviceId         String
  phoneNumber      String   @default("")
  status           String   @default("pending")
  moderationStatus String   @default("approved")   // approved | rejected | pending_review
  moderationReason String?
  printStatus      String   @default("not_sent")    // not_sent | sent | printed
  createdAt        DateTime @default(now())

  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  overlay          Overlay? @relation(fields: [overlayId], references: [id])

  @@index([eventId])
  @@index([deviceId])
  @@index([phoneNumber])
}
